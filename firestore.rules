rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSpendfloUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@spendflo[.]com$');
    }

    match /{document=**} {
      allow read, write: if isSpendfloUser();
    }
  }
}
